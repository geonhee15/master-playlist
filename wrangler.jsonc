{
  // Cloudflare Workers 배포 설정 — 정적 에셋(dist) + /api/* 처리 워커
  "name": "master-playlist",
  "compatibility_date": "2025-06-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  // R2 클라우드 미디어 저장소 — 대시보드에서 같은 이름의 버킷을 먼저 만들어야 배포된다
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "master-playlist-media"
    }
  ]
}
